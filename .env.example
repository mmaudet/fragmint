# Copy this file to `.env` at the repo root and fill in your values.
# `.env` is gitignored. Docker Compose auto-loads it.
#
# LLM and embedding are configured independently — you can point them at
# different providers, use different API keys, and pick different models.

# --- LLM (chat completions) ---
FRAGMINT_LLM_ENDPOINT=https://ai.linagora.com/openai/v1
FRAGMINT_LLM_API_KEY=sk-replace-me
FRAGMINT_LLM_MODEL=mistral-nemo:12b

# --- Embeddings ---
# Set DIMENSIONS to match the model's output vector size (nomic-embed-text-v2-moe=768,
# Qwen3-Embedding-0.6B=1024, text-embedding-3-large=3072, etc.). The Milvus collection
# is created with this dimension on first boot — if you change it later, drop the
# collection or wipe the milvus-data volume so it recreates.
FRAGMINT_EMBEDDING_ENDPOINT=https://ai.linagora.com/openai/v1
FRAGMINT_EMBEDDING_API_KEY=sk-replace-me
FRAGMINT_EMBEDDING_MODEL=nomic-embed-text-v2-moe
FRAGMINT_EMBEDDING_DIMENSIONS=768
