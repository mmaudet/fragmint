{
  "name": "fragmint",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p packages/server/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "docx": "^9.6.1",
    "prettier": "^3.8.3",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "license": "AGPL-3.0-only",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "msw",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "diff": "^9.0.0"
  }
}
